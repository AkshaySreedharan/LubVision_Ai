{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/analyze",
      "destination": "/api/analyze.py"
    },
    {
      "source": "/api/report/pdf",
      "destination": "/api/report.py"
    },
    {
      "source": "/api/report",
      "destination": "/api/report.py"
    },
    {
      "source": "/api/status",
      "destination": "/api/status.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/status.py"
    },
    {
      "source": "/analyze",
      "destination": "/api/analyze.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    }
  ]
}
